.section-header-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 0 12rpx 16rpx;
  border-left: 8rpx solid var(--color-life);
  margin-left: -16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-left: 8rpx;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.tool-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
}

/* 运营角标：很火 / 很赞（右上角） */
.tool-corner-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.5;
  border-radius: 0 16rpx 0 16rpx;
}

.badge-hot {
  color: #E8442E;
  background: #FFE9E0;
}

.badge-praise {
  color: #C77800;
  background: #FFF3D6;
}

.tool-card:active { transform: scale(0.97); }

.tool-icon { font-size: 36rpx; margin-right: 16rpx; }

.tool-name { font-size: 28rpx; font-weight: 500; color: var(--color-primary); }

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

page {
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}
