<view class="container" style="background:{{bgColor}}">

  <!-- 吸顶头：分类主色柔和头 + 搜索 + 筛选 -->
  <view class="cat-header" style="background:{{bgColor}}">
    <view class="cat-head-bar">
      <view class="cat-head-ico" style="background:{{color}}">{{icon}}</view>
      <text class="cat-head-name">{{catName}}</text>
    </view>

    <view class="cat-search">
      <text class="cat-search-ico">🔍</text>
      <input
        class="cat-search-input"
        placeholder="搜索本类工具"
        value="{{keywords}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
    </view>

    <view class="cat-chips" style="--chip-color:{{color}}">
      <view class="cat-chip {{filter==='all'?'chip-on':''}}" data-f="all" bindtap="onFilterTap">全部</view>
      <view class="cat-chip {{filter==='hot'?'chip-on':''}}" data-f="hot" bindtap="onFilterTap">热门</view>
    </view>
  </view>

  <!-- 三列密集网格 -->
  <view class="cat-body">
    <view class="cat-grid">
      <view
        class="cat-card-x"
        wx:for="{{displayTools}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToolTap"
        hover-class="cat-card-hover"
      >
        <view class="cat-card-ico" style="background:{{item.bgColor}}">
          {{item.icon}}
          <text wx:if="{{item.badgeEmoji}}" class="cat-card-badge badge-{{item.badgeType}}">{{item.badgeEmoji}}</text>
        </view>
        <view class="cat-card-name-row">
          <text class="cat-card-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{displayTools.length === 0}}" class="cat-empty">
      <text class="cat-empty-icon">🔍</text>
      <text class="cat-empty-text">没有匹配的工具</text>
    </view>

    <view class="bottom-space"></view>
  </view>
</view>
