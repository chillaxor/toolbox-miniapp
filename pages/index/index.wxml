<view class="container">

  <!-- 搜索栏：始终可见，吸顶 -->
  <view class="search-wrap">
    <view class="search-pill">
      <text class="search-ico">🔍</text>
      <input
        class="search-input"
        placeholder="搜索99+个工具"
        value="{{searchText}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text wx:if="{{searchText}}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>
  </view>

  <!-- 搜索结果 -->
  <block wx:if="{{searchText}}">
    <view wx:if="{{searchResults.length > 0}}" class="search-results">
      <view class="search-result-grid">
        <view class="search-result-item" wx:for="{{searchResults}}" wx:key="id">
          <tool-card
            toolId="{{item.id}}"
            name="{{item.name}}"
            icon="{{item.icon}}"
            description="{{item.description}}"
            color="{{item.categoryColor}}"
            bgColor="{{item.categoryBgColor}}"
            path="{{item.path}}"
            badgeType="{{item.badgeType}}"
            badgeText="{{item.badgeText}}"
            badgeEmoji="{{item.badgeEmoji}}"
          />
        </view>
      </view>
    </view>
    <view wx:else class="search-empty">
      <text class="search-empty-icon">🔍</text>
      <text class="search-empty-text">没有找到匹配的工具</text>
    </view>
  </block>

  <!-- 首页主体 -->
  <block wx:else>

    <!-- 品牌头区（和谐暖色渐变 + 悬浮圆角卡片） -->
    <view class="hero">
      <view class="hero-blob hero-blob-1"></view>
      <view class="hero-blob hero-blob-2"></view>
      <view class="hero-top">
        <view class="hero-brand">拾光工具屋</view>
        <view class="hero-avatar">我</view>
      </view>
      <view class="hero-sub">
        <text class="hero-sub-line">99+个小工具·随时待命</text>
        <text class="hero-sub-line hero-sub-en">Be water, my friend</text>
      </view>
    </view>

    <!-- 最近使用 -->
    <view wx:if="{{recentTools.length > 0}}" class="section">
      <view class="sec-head">
        <text class="sec-title">最近使用</text>
      </view>
      <scroll-view class="recent-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="recent-row">
          <view
            class="recent-chip"
            wx:for="{{recentTools}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onToolTap"
            hover-class="recent-chip-hover"
          >
            <view class="recent-ico" style="background:{{item.bgColor}}">{{item.icon}}</view>
            <text class="recent-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 今日精选 -->
    <view class="section">
      <view class="sec-head">
        <text class="sec-title">今日精选</text>
      </view>
      <scroll-view class="feat-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="feat-row">
          <view
            class="feat-card"
            wx:for="{{featuredList}}"
            wx:key="id"
            data-id="{{item.id}}"
            data-path="{{item.path}}"
            bindtap="onFeaturedTap"
            hover-class="feat-card-hover"
          >
            <text class="feat-emoji">{{item.icon}}</text>
            <view class="feat-info">
              <text class="feat-title">{{item.title}}</text>
              <text class="feat-sub">{{item.subtitle}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 全部分类（浅柔彩底 + 同色系图标块，整体协调） -->
    <view class="section">
      <view class="sec-head">
        <text class="sec-title">全部分类</text>
      </view>
      <view class="cat-grid">
        <view
          class="cat-card"
          wx:for="{{categoryList}}"
          wx:key="id"
          style="background:{{item.bgColor}}"
          data-index="{{index}}"
          bindtap="onCategoryTap"
          hover-class="cat-card-hover"
        >
          <view class="cat-emoji" style="background:{{item.color}}">{{item.icon}}</view>
          <view class="cat-meta">
            <text class="cat-name">{{item.name}}</text>
            <text class="cat-count">{{item.count}}个工具</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 热门工具：按分类分组的多列密集网格（V2 首页） -->
    <block wx:if="{{homepageV2}}">
      <view class="section" wx:for="{{popularGroups}}" wx:key="catId" wx:for-item="group">
        <view class="sec-head">
          <view class="cat-dot" style="background:{{group.color}}"></view>
          <text class="sec-title">{{group.name}}</text>
          <text class="sec-more" data-cat="{{group.catId}}" bindtap="onViewAll">查看全部 ›</text>
        </view>
        <view class="pop-grid">
          <view
            class="pop-card"
            wx:for="{{group.tools}}"
            wx:key="id"
            wx:for-item="tool"
            data-id="{{tool.id}}"
            bindtap="onToolTap"
            hover-class="pop-card-hover"
          >
            <view class="pop-ico" style="background:{{tool.bgColor}}">
              {{tool.icon}}
              <text wx:if="{{tool.badgeEmoji}}" class="pop-badge badge-{{tool.badgeType}}">{{tool.badgeEmoji}}</text>
            </view>
            <text class="pop-name">{{tool.name}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 分类工具列表（旧版首页：点分类在此堆整类长列表） -->
    <block wx:else>
      <view id="toolList" class="section">
        <view class="sec-head">
          <view class="cat-dot" style="background:{{activeColor}}"></view>
          <text class="sec-title">{{activeCategoryName}}</text>
        </view>
        <view class="tool-list">
          <view
            class="tool-row"
            wx:for="{{currentTools}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onToolTap"
            hover-class="tool-row-hover"
          >
            <view class="tool-ico" style="background:{{item.bgColor}}">
              {{item.icon}}
              <text wx:if="{{item.badgeEmoji}}" class="tool-badge badge-{{item.badgeType}}">{{item.badgeEmoji}}</text>
            </view>
            <view class="tool-text">
              <view class="tool-name-row">
                <text class="tool-name">{{item.name}}</text>
              </view>
              <text class="tool-desc">{{item.description}}</text>
            </view>
            <text class="tool-arrow">›</text>
          </view>
        </view>
      </view>
    </block>

    <view class="bottom-space"></view>
  </block>
</view>
