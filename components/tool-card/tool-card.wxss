.tool-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 38, 89, 0.07);
  transition: all 0.2s ease;
}

.tool-card-hover {
  transform: scale(0.97);
  opacity: 0.95;
}

.tool-card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}

.tool-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.tool-card-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.tool-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a2e3d;
  line-height: 1.4;
}

/* 运营角标：图标右上角小徽章 */
.tool-card-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  line-height: 1;
  border-radius: 999rpx;
  border: 2rpx solid #ffffff;
  flex-shrink: 0;
}

.badge-hot {
  color: #E8442E;
  background: #FFE9E0;
}

.badge-praise {
  color: #C77800;
  background: #FFF3D6;
}

.tool-card-desc {
  font-size: 23rpx;
  color: #9aa0ad;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-card-arrow {
  font-size: 36rpx;
  color: #c8ccd6;
  margin-left: 12rpx;
  flex-shrink: 0;
}
