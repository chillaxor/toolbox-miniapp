.page { padding: 24rpx 28rpx 60rpx; min-height: 100vh; box-sizing: border-box; background: linear-gradient(180deg, #E3F2FD 0%, #E8EAF6 60%, #FFFFFF 100%); }

/* ===== 首页 ===== */
.hero { display: flex; flex-direction: column; align-items: center; padding: 30rpx 0 20rpx; }
.hero-emoji { font-size: 76rpx; }
.hero-title { font-size: 44rpx; font-weight: 800; color: #1565C0; margin-top: 8rpx; }
.hero-sub { font-size: 26rpx; color: #5C6BC0; margin-top: 10rpx; text-align: center; }

.mod-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 24rpx; }
.mod-card { position: relative; width: calc(50% - 10rpx); background: #fff; border-radius: 24rpx; padding: 26rpx 22rpx; box-shadow: 0 6rpx 18rpx rgba(33,150,243,0.12); }
.mod-emoji { font-size: 48rpx; }
.mod-name { display: block; font-size: 32rpx; font-weight: 800; color: #1A237E; margin-top: 6rpx; }
.mod-desc { display: block; font-size: 23rpx; color: #7986CB; margin-top: 8rpx; line-height: 1.4; }
.mod-on { position: absolute; top: 18rpx; right: 18rpx; background: #FFB300; color: #fff; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }

.pick { margin-top: 28rpx; }
.pick-label { font-size: 26rpx; color: #3949AB; font-weight: 700; }
.pills { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.pill { background: #fff; color: #3949AB; border: 2rpx solid #90CAF9; border-radius: 30rpx; padding: 12rpx 26rpx; font-size: 26rpx; }
.pill-on { background: #42A5F5; color: #fff; border-color: #42A5F5; font-weight: 700; }

.start-btn { margin-top: 36rpx; background: linear-gradient(90deg, #42A5F5, #1E88E5); color: #fff; font-size: 34rpx; font-weight: 800; border-radius: 44rpx; padding: 22rpx 0; box-shadow: 0 8rpx 20rpx rgba(30,136,229,0.30); }
.wb-tip { margin-top: 22rpx; background: #FFF3E0; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 24rpx; color: #EF6C00; text-align: center; }

/* ===== 练习 ===== */
.topbar { display: flex; justify-content: space-between; align-items: center; }
.prog { font-size: 28rpx; color: #3949AB; font-weight: 700; }
.modtag { font-size: 24rpx; color: #fff; background: #64B5F6; border-radius: 20rpx; padding: 4rpx 18rpx; }

.fb { margin-top: 18rpx; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 26rpx; }
.fb-ok { background: #E8F5E9; color: #2E7D32; }
.fb-wrong { background: #FFEBEE; color: #C62828; }
.deriv { margin-top: 12rpx; background: #FFF8E1; border-left: 6rpx solid #FFB300; border-radius: 12rpx; padding: 16rpx 18rpx; font-size: 25rpx; color: #F57F17; line-height: 1.5; }

.card { margin-top: 22rpx; background: #fff; border-radius: 24rpx; padding: 30rpx 26rpx; box-shadow: 0 6rpx 18rpx rgba(33,150,243,0.12); }

.steps { display: flex; gap: 18rpx; justify-content: center; margin-bottom: 18rpx; }
.step-dot { width: 56rpx; height: 56rpx; border-radius: 50%; background: #ECEFF1; color: #90A4AE; font-size: 28rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.step-dot.cur { background: #FFB300; color: #fff; }
.step-dot.done { background: #90CAF9; color: #fff; }

.q { display: block; font-size: 30rpx; color: #37474F; font-weight: 700; margin-bottom: 18rpx; line-height: 1.5; }

.dotwrap { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 10rpx 0 4rpx; }
.dot { width: 60rpx; height: 60rpx; border-radius: 50%; box-shadow: inset 0 -4rpx 0 rgba(0,0,0,0.08); transition: transform .12s; }
.dot.sm { width: 38rpx; height: 38rpx; border-radius: 50%; }
.dotwrap.small { gap: 6rpx; }
.count-hint { display: block; font-size: 26rpx; color: #3949AB; margin: 14rpx 0; }

.next-btn { margin-top: 10rpx; background: #42A5F5; color: #fff; border-radius: 40rpx; font-size: 30rpx; font-weight: 700; }
.next-btn[disabled] { background: #CFD8DC; color: #fff; }

.expr { display: flex; align-items: center; gap: 18rpx; margin: 10rpx 0 20rpx; }
.expr-txt { font-size: 38rpx; font-weight: 800; color: #1565C0; }
.expr-txt.big { font-size: 56rpx; }
.ans { width: 160rpx; height: 72rpx; border: 3rpx solid #90CAF9; border-radius: 16rpx; text-align: center; font-size: 38rpx; font-weight: 800; color: #1A237E; background: #E3F2FD; }
.ans.sm { width: 120rpx; height: 60rpx; font-size: 32rpx; }

.check-btn { margin-top: 6rpx; background: #42A5F5; color: #fff; border-radius: 40rpx; font-size: 30rpx; font-weight: 700; }
.opts { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 6rpx; }
.opt { min-width: 200rpx; text-align: center; background: #E3F2FD; border: 3rpx solid #90CAF9; border-radius: 18rpx; padding: 26rpx 10rpx; font-size: 36rpx; font-weight: 800; color: #1A237E; }
.opt-right { border-color: #42A5F5; background: #E3F2FD; }

/* 分法对比 */
.compare-row { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.compare-box { display: flex; flex-direction: column; align-items: center; background: #FAFAFA; border-radius: 18rpx; padding: 18rpx; width: 100%; }
.compare-label { font-size: 32rpx; font-weight: 800; color: #37474F; margin-bottom: 8rpx; }
.compare-eq { font-size: 24rpx; color: #90A4AE; margin: 6rpx 0; }

/* 编商 */
.ladder { display: flex; flex-direction: column; gap: 10rpx; }
.lrow { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 16rpx; border-radius: 14rpx; background: #F5F5F5; }
.lrow-blank { background: #FFF8E1; }
.lrow-done { background: #E8F5E9; }
.ltext { font-size: 30rpx; font-weight: 700; color: #455A64; min-width: 200rpx; }
.lval { font-size: 30rpx; font-weight: 800; color: #2E7D32; }
.mini-check { background: #42A5F5; color: #fff; border-radius: 50%; width: 64rpx; height: 64rpx; line-height: 64rpx; padding: 0; font-size: 32rpx; font-weight: 800; }

/* 结果 */
.result { display: flex; flex-direction: column; align-items: center; padding-top: 60rpx; }
.res-title { font-size: 40rpx; font-weight: 800; color: #1565C0; }
.stars { display: flex; gap: 16rpx; margin: 26rpx 0; }
.star { font-size: 80rpx; color: #CFD8DC; }
.star-on { color: #FFB300; }
.weak { background: #FFF3E0; border-radius: 18rpx; padding: 22rpx 26rpx; text-align: center; margin-bottom: 20rpx; }
.weak.ok { background: #E8F5E9; }
.weak-t { display: block; font-size: 26rpx; color: #EF6C00; }
.weak-v { display: block; font-size: 34rpx; font-weight: 800; color: #E65100; margin-top: 8rpx; }
.ghost-btn { margin-top: 16rpx; background: #fff; color: #3949AB; border: 2rpx solid #90CAF9; border-radius: 44rpx; font-size: 30rpx; padding: 18rpx 0; width: 100%; }
.cross-sell { margin-top: 22rpx; background: #FFF8E1; border-radius: 16rpx; padding: 18rpx 20rpx; font-size: 24rpx; color: #F9A825; text-align: center; }
