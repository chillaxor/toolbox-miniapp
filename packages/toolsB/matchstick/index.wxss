.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFEFE0 100%);
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page { display: flex; flex-direction: column; align-items: center; }

/* 介绍页 */
.hero { font-size: 120rpx; margin-top: 40rpx; }
.title { font-size: 48rpx; font-weight: 800; color: #E2622B; margin-top: 10rpx; }
.subtitle { font-size: 30rpx; color: #8D6E63; margin-top: 12rpx; }
.desc {
  font-size: 26rpx; color: #A1887F; line-height: 1.6;
  margin: 28rpx 20rpx 12rpx; text-align: center;
}

.count-sel { width: 100%; margin: 30rpx 0 8rpx; }
.cs-label { font-size: 26rpx; color: #8D6E63; margin-left: 8rpx; }
.cs-row { display: flex; justify-content: space-between; margin-top: 14rpx; }
.cs-item {
  flex: 1; margin: 0 8rpx; text-align: center;
  padding: 18rpx 0; border-radius: 18rpx;
  background: #fff; color: #A1887F; font-size: 28rpx; font-weight: 600;
  border: 3rpx solid transparent;
}
.cs-on { background: #FFE0CC; color: #E2622B; border-color: #FF7043; }

/* 按钮 */
.btn-primary {
  width: 80%; margin-top: 36rpx; padding: 24rpx 0;
  background: #FF7043; color: #fff; font-size: 32rpx; font-weight: 700;
  border-radius: 44rpx; border: none; box-shadow: 0 8rpx 18rpx rgba(255, 112, 67, 0.35);
}
.btn-ghost {
  width: 80%; margin-top: 20rpx; padding: 22rpx 0;
  background: #fff; color: #8D6E63; font-size: 30rpx;
  border-radius: 44rpx; border: 3rpx solid #FFD0B8;
}

/* 历史 */
.history { width: 100%; margin-top: 40rpx; }
.h-title { font-size: 26rpx; color: #8D6E63; margin: 0 8rpx 10rpx; }
.h-item {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff; border-radius: 16rpx; padding: 16rpx 22rpx; margin: 10rpx 4rpx;
}
.h-sum { font-size: 28rpx; color: #5D4037; font-weight: 600; }
.h-time { font-size: 22rpx; color: #BCAAA4; }

/* 游戏页 */
.topbar { width: 100%; display: flex; justify-content: space-between; align-items: center; }
.qnum { font-size: 28rpx; color: #8D6E63; font-weight: 600; }
.score { font-size: 30rpx; color: #E2622B; font-weight: 700; }
.progress { width: 100%; height: 16rpx; background: #FFE0CC; border-radius: 10rpx; margin: 14rpx 0 30rpx; overflow: hidden; }
.bar { height: 100%; background: linear-gradient(90deg, #FFA726, #FF7043); border-radius: 10rpx; transition: width 0.3s ease; }
.tip { font-size: 30rpx; color: #6D4C41; margin-bottom: 24rpx; font-weight: 600; }

/* 火柴算式 */
.eqrow {
  display: flex; align-items: center; justify-content: center;
  background: #fff; border-radius: 28rpx; padding: 44rpx 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(230, 81, 0, 0.12);
}
.slot { position: relative; width: 64rpx; height: 116rpx; margin: 0 8rpx; }
.seg { position: absolute; border-radius: 5rpx; }

/* 七段位置 */
.seg-a { left: 12rpx; top: 6rpx; width: 40rpx; height: 10rpx; }
.seg-f { left: 4rpx;  top: 14rpx; width: 10rpx; height: 42rpx; }
.seg-b { left: 50rpx; top: 14rpx; width: 10rpx; height: 42rpx; }
.seg-g { left: 12rpx; top: 54rpx; width: 40rpx; height: 10rpx; }
.seg-e { left: 4rpx;  top: 62rpx; width: 10rpx; height: 42rpx; }
.seg-c { left: 50rpx; top: 62rpx; width: 10rpx; height: 42rpx; }
.seg-d { left: 12rpx; top: 102rpx; width: 40rpx; height: 10rpx; }
/* 运算符 + */
.seg-v { left: 27rpx; top: 14rpx; width: 10rpx; height: 88rpx; }
/* 运算符 = */
.seg-eq1 { left: 12rpx; top: 46rpx; width: 40rpx; height: 9rpx; }
.seg-eq2 { left: 12rpx; top: 66rpx; width: 40rpx; height: 9rpx; }

/* 状态颜色 */
.seg-on { background: #FF7043; box-shadow: 0 2rpx 0 #D84315; }
.seg-off { background: rgba(255, 112, 67, 0.16); }
.seg-carry {
  background: repeating-linear-gradient(45deg, #FFB74D, #FFB74D 6rpx, transparent 6rpx, transparent 12rpx);
  opacity: 0.85;
}
.seg-hint { background: #FFD54F; animation: blink 0.6s infinite alternate; }
@keyframes blink { from { opacity: 0.4; } to { opacity: 1; } }

/* 反馈 */
.feedback { margin-top: 28rpx; padding: 16rpx 28rpx; border-radius: 18rpx; font-size: 30rpx; font-weight: 700; }
.fb-ok { color: #2E7D32; background: #E8F5E9; }
.fb-no { color: #C62828; background: #FFEBEE; }
.auto-tip { margin-top: 16rpx; font-size: 24rpx; color: #BCAAA4; }

.actions { display: flex; margin-top: 36rpx; }
.btn-mini {
  flex: 1; margin: 0 12rpx; padding: 18rpx 0;
  background: #fff; color: #E2622B; font-size: 28rpx; font-weight: 600;
  border-radius: 36rpx; border: 3rpx solid #FFD0B8;
}

/* 成绩页 */
.stars { margin: 30rpx 0 10rpx; }
.star { font-size: 72rpx; margin: 0 8rpx; }
.star.on { color: #FFB300; }
.star.off { color: #E0E0E0; }
.score-big { font-size: 34rpx; color: #6D4C41; font-weight: 700; margin-bottom: 10rpx; }
