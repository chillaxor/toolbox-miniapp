.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 搜索框 */
.search-bar {
  margin-bottom: 18rpx;
}
.search-input {
  width: 100%;
  height: 76rpx;
  background: #ffffff;
  border-radius: 38rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #222;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.ph { color: #b0b4bd; }

/* 分类 tab */
.tabs {
  white-space: nowrap;
  margin-bottom: 18rpx;
}
.tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  background: #fff;
  color: #555;
  font-size: 26rpx;
  border-radius: 30rpx;
}
.tab-on {
  background: #4ECDC4;
  color: #fff;
  font-weight: 600;
}

/* 列表 */
.list { }
.link-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.link-name {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
  flex: 0 0 auto;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.link-url {
  flex: 1;
  font-size: 24rpx;
  color: #9aa0aa;
  margin: 0 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.link-arrow {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: #4ECDC4;
  border: 1rpx solid #4ECDC4;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #9aa0aa; }

/* 弹窗 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.popup {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.18);
}
.popup-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 48rpx;
  border-radius: 50%;
  background: #e8fbf9;
  margin: 0 auto 20rpx;
}
.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 18rpx;
}
.popup-url {
  font-size: 25rpx;
  color: #4a4f57;
  word-break: break-all;
  background: #f5f6fa;
  border: 1rpx solid #eef0f3;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 30rpx;
  line-height: 1.6;
  text-align: left;
}
.copy-btn {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4ECDC4, #38b2ac);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  margin-bottom: 14rpx;
}
.copy-btn:active { opacity: 0.88; }
.popup-close {
  font-size: 28rpx;
  color: #9aa0aa;
  padding: 12rpx 0;
}
