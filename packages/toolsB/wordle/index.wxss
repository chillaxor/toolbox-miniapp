.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}
.head {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.title { font-size: 40rpx; font-weight: 700; color: #222; }
.modes { display: flex; }
.mode {
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 18rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  margin-left: 12rpx;
}
.mode.on { color: #fff; background: #6aaa64; border-color: #6aaa64; }

.riddle {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #e7e7e7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.riddle-head { display: flex; justify-content: space-between; align-items: center; }
.riddle-title { font-size: 28rpx; font-weight: 700; color: #333; }
.riddle-toggle { font-size: 24rpx; color: #6aaa64; }
.riddle-line { display: flex; align-items: flex-start; margin-top: 16rpx; }
.m-label {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #6aaa64;
  background: #eef6ec;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 14rpx;
}
.m-val { font-size: 28rpx; color: #444; line-height: 1.5; }
.riddle-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.tag {
  font-size: 22rpx;
  color: #b07d2b;
  background: #fbf3e2;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}
.riddle-first {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #c0392b;
  font-weight: 700;
}
.riddle-hintbtn {
  margin-top: 18rpx;
  align-self: flex-start;
  font-size: 24rpx;
  color: #6aaa64;
  border: 1rpx dashed #6aaa64;
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
}

.grid { display: flex; flex-direction: column; gap: 12rpx; margin: 12rpx 0 24rpx; }
.row { display: flex; gap: 12rpx; }
.cell {
  width: 110rpx;
  height: 110rpx;
  border: 2rpx solid #d4d6da;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}
.cell .ch { font-size: 48rpx; font-weight: 700; color: #222; }
.cell.g { background: #6aaa64; border-color: #6aaa64; }
.cell.g .ch { color: #fff; }
.cell.y { background: #c9b458; border-color: #c9b458; }
.cell.y .ch { color: #fff; }
.cell.r { background: #787c7e; border-color: #787c7e; }
.cell.r .ch { color: #fff; }

.msg { color: #e06c4f; font-size: 26rpx; min-height: 36rpx; margin-bottom: 8rpx; }
.inp {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  background: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}
.btn {
  width: 100%;
  background: #6aaa64;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-bottom: 16rpx;
}
.btn.ghost { background: #fff; color: #6aaa64; border: 1rpx solid #6aaa64; }

.stats { display: flex; gap: 36rpx; margin-top: 12rpx; }
.stat { display: flex; flex-direction: column; align-items: center; }
.stat .num { font-size: 36rpx; font-weight: 700; color: #222; }
.stat .lab { font-size: 22rpx; color: #999; }

.result {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); }
.panel {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rtitle { font-size: 44rpx; font-weight: 700; color: #222; margin-bottom: 16rpx; }
.rword { font-size: 30rpx; color: #555; margin-bottom: 24rpx; }
.share {
  width: 100%;
  box-sizing: border-box;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333;
  margin-bottom: 24rpx;
}
