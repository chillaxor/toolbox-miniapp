/* ============ 基础布局 ============ */
.page {
  min-height: 100vh;
  padding: 36rpx 30rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #E8F5E9 0%, #C8E6C9 100%);
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  color: #1B5E20;
  text-align: center;
  margin-top: 10rpx;
}
.desc {
  font-size: 28rpx;
  color: #4E6E50;
  line-height: 1.7;
  margin: 16rpx 12rpx 28rpx;
  text-align: center;
}

.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #2E7D32;
  margin: 26rpx 0 14rpx;
}

/* ============ 钱币 CSS 绘制（零图片素材，规避人民币图样风险） ============ */
.money {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  color: #5D4037;
  box-sizing: border-box;
  line-height: 1;
  text-align: center;
}

/* 硬币：圆形 + 金属渐变 */
.coin {
  border-radius: 50%;
  width: 104rpx;
  height: 104rpx;
  font-size: 28rpx;
  color: #6D4C00;
  border: 6rpx solid #E6B422;
  background: radial-gradient(circle at 34% 30%, #FFF7CF, #F2C94C 58%, #D4A017 100%);
  box-shadow: 0 4rpx 10rpx rgba(180, 140, 0, 0.32), inset 0 0 0 4rpx rgba(255, 255, 255, 0.4);
}
.coin-j1 { /* 1角：银色小角币 */
  border-color: #B0BEC5;
  background: radial-gradient(circle at 34% 30%, #FFFFFF, #CFD8DC 58%, #90A4AE 100%);
  color: #455A64;
}
.coin-j5 { /* 5角：金色角币 */
  border-color: #C9A227;
  background: radial-gradient(circle at 34% 30%, #FFF7CF, #EFC13A 58%, #C79A1E 100%);
}
.coin-y1 { /* 1元硬币：大金圆 */
  width: 116rpx;
  height: 116rpx;
  font-size: 30rpx;
}

/* 纸币：圆角纸片 + 彩色左侧条 */
.bill {
  width: 148rpx;
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4E342E;
  background: linear-gradient(135deg, #FFFDF6, #F1E7CE);
  border: 2rpx solid #C9B98C;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.12);
}
.bill-1   { border-left: 12rpx solid #6D4C41; }
.bill-5   { border-left: 12rpx solid #2E7D32; }
.bill-10  { border-left: 12rpx solid #1565C0; }
.bill-20  { border-left: 12rpx solid #AD1457; }
.bill-50  { border-left: 12rpx solid #00897B; }
.bill-100 { border-left: 12rpx solid #C62828; }

/* 大小修饰（与 coin/bill 同元素叠加） */
.money-lg.coin { width: 156rpx; height: 156rpx; font-size: 40rpx; }
.money-lg.bill { width: 220rpx; height: 112rpx; font-size: 38rpx; }
.money-sm.coin { width: 86rpx; height: 86rpx; font-size: 24rpx; }
.money-sm.bill { width: 116rpx; height: 60rpx; font-size: 22rpx; }

/* ============ 介绍页 ============ */
.intro { }
.gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 50, 0.10);
}
.g-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 22rpx;
}
.g-tag {
  font-size: 22rpx;
  color: #8AA890;
  margin-top: 8rpx;
}
.tip-line {
  font-size: 24rpx;
  color: #6E8A72;
  background: #F1F8F2;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

.pills { display: flex; flex-wrap: wrap; }
.pill {
  flex: 1;
  min-width: 150rpx;
  text-align: center;
  padding: 18rpx 8rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #4E6E50;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pill:last-child { margin-right: 0; }
.pill-on {
  background: #43A047;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(67, 160, 71, 0.35);
}
.pill-name { font-size: 30rpx; font-weight: 700; }
.pill-desc { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.pill-sm { flex: 0 0 auto; min-width: 0; padding: 16rpx 36rpx; margin-right: 18rpx; }
.pill-sm .pill-name { font-size: 28rpx; }

.btn-start {
  background: linear-gradient(90deg, #66BB6A, #43A047);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 50rpx;
  padding: 22rpx 0;
  margin-top: 34rpx;
  box-shadow: 0 8rpx 22rpx rgba(67, 160, 71, 0.35);
}
.btn-start::after { border: none; }

.history { margin-top: 44rpx; background: #fff; border-radius: 20rpx; padding: 20rpx 28rpx; }
.h-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #4E6E50;
  padding: 12rpx 0;
  border-top: 2rpx solid #F1F8F2;
}
.h-score { font-weight: 700; color: #2E7D32; }
.h-star { color: #FB8C00; }
.h-dt { color: #B0BEC5; font-size: 22rpx; }

/* ============ 答题页 ============ */
.play { }
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.progress-wrap {
  flex: 1;
  height: 14rpx;
  background: #C8E6C9;
  border-radius: 10rpx;
  margin-right: 18rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #81C784, #43A047);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}
.score-txt { font-size: 26rpx; color: #2E7D32; font-weight: 600; white-space: nowrap; }

.q-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 50, 0.10);
}
.q-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1B5E20;
  text-align: center;
  margin-bottom: 22rpx;
  line-height: 1.5;
}
.q-text-sm { font-size: 30rpx; font-weight: 600; color: #33691E; }
.center { text-align: center; }

/* 题型 A：认一认 */
.show-money-wrap { display: flex; justify-content: center; margin: 18rpx 0 26rpx; }
.opts { }
.opt {
  background: #F1F8F2;
  border: 3rpx solid #C8E6C9;
  border-radius: 18rpx;
  padding: 26rpx 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 18rpx;
  transition: all 0.15s ease;
}
.opt-correct { border-color: #43A047; background: #E8F5E9; color: #1B5E20; }
.opt-wrong { border-color: #E53935; background: #FFEBEE; color: #C62828; }

.find-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.find-cell {
  width: 47%;
  background: #F1F8F2;
  border: 3rpx solid #C8E6C9;
  border-radius: 18rpx;
  padding: 26rpx 0;
  margin-bottom: 22rpx;
  display: flex;
  justify-content: center;
  transition: all 0.15s ease;
}
.find-correct { border-color: #43A047; background: #E8F5E9; }
.find-wrong { border-color: #E53935; background: #FFEBEE; }

/* 题型 B：付钱 / C-pick 找零 */
.price-tag {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
}
.pt-emoji { font-size: 64rpx; margin-right: 18rpx; }
.pt-info { display: flex; flex-direction: column; }
.pt-name { font-size: 32rpx; font-weight: 700; color: #5D4037; }
/* 超市风价签：橙红标签 + ¥大数字.两位小角 */
.pt-price {
  display: inline-flex;
  align-items: baseline;
  background: linear-gradient(135deg, #FF7043, #F4511E);
  color: #fff;
  font-weight: 800;
  border-radius: 14rpx;
  padding: 6rpx 18rpx;
  margin-top: 6rpx;
  box-shadow: 0 4rpx 10rpx rgba(244, 81, 30, 0.30);
  line-height: 1;
}
.pt-cur { font-size: 26rpx; margin-right: 2rpx; }
.pt-y { font-size: 46rpx; line-height: 1; }
.pt-d { font-size: 26rpx; }

.paid-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  margin: 10rpx 0 18rpx;
}
.paid-txt { font-size: 30rpx; color: #33691E; font-weight: 600; margin-right: 16rpx; }

.tray {
  background: #fff;
  border-radius: 22rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
  border: 3rpx dashed #A5D6A7;
  box-shadow: 0 6rpx 18rpx rgba(46, 125, 50, 0.10);
  transition: all 0.2s ease;
}
.tray-over { border-color: #FFB74D; background: #FFF8E1; }
.tray-done { border-color: #43A047; background: #E8F5E9; }
.tray-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.tray-title { font-size: 28rpx; font-weight: 700; color: #2E7D32; }
.tray-total { font-size: 28rpx; font-weight: 800; color: #E65100; }
.tray-body {
  display: flex;
  flex-wrap: wrap;
  min-height: 96rpx;
  align-items: center;
}
.tray-empty {
  font-size: 26rpx;
  color: #9E9E9E;
  width: 100%;
  text-align: center;
  padding: 28rpx 0;
}
.tray-piece {
  margin: 6rpx 10rpx 6rpx 0;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #F1F8F2;
}
.tray-hint {
  font-size: 26rpx;
  color: #EF6C00;
  font-weight: 600;
  margin-top: 12rpx;
  text-align: center;
}

.wallet { }
.w-groups {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 22rpx;
  padding: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(46, 125, 50, 0.10);
}
.w-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 10rpx 18rpx 10rpx 0;
  padding: 10rpx;
  border-radius: 16rpx;
  background: #F1F8F2;
  transition: transform 0.12s ease;
}
.w-group:active { transform: scale(0.94); }
.w-empty { opacity: 0.32; }
.w-count {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 700;
  margin-top: 4rpx;
}

/* 题型 C-fill 找零填数 */
.fill-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.fill-input {
  width: 110rpx;
  height: 84rpx;
  background: #F1F8F2;
  border: 3rpx solid #A5D6A7;
  border-radius: 16rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #1B5E20;
  margin: 0 10rpx;
}
.fill-unit { font-size: 30rpx; color: #2E7D32; font-weight: 700; margin-right: 16rpx; }
.btn-submit {
  background: linear-gradient(90deg, #66BB6A, #43A047);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 14rpx 40rpx;
  margin-left: 10rpx;
}
.btn-submit::after { border: none; }
.btn-dim { background: #B0BEC5; box-shadow: none; }
.fill-hint {
  font-size: 26rpx;
  color: #EF6C00;
  background: #FFF3E0;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.6;
}

/* 反馈条 */
.feedback {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
  padding: 16rpx;
  border-radius: 14rpx;
}
.fb-ok { color: #1B5E20; background: #E8F5E9; }
.fb-no { color: #C62828; background: #FFEBEE; }
.next-hint {
  text-align: center;
  font-size: 28rpx;
  color: #43A047;
  font-weight: 700;
  padding: 14rpx;
  border: 2rpx dashed #A5D6A7;
  border-radius: 14rpx;
  margin-top: 10rpx;
}

/* ============ 结算页 ============ */
.result {
  padding-top: 40rpx;
  text-align: center;
}
.r-stars { margin: 20rpx 0 10rpx; }
.r-star {
  font-size: 72rpx;
  color: #C8E6C9;
  margin: 0 8rpx;
}
.r-star-on { color: #FFB300; }
.r-score {
  font-size: 40rpx;
  font-weight: 800;
  color: #1B5E20;
}
.r-minstar {
  font-size: 28rpx;
  color: #FB8C00;
  font-weight: 700;
  margin-top: 10rpx;
}
.r-breakdown {
  background: #fff;
  border-radius: 22rpx;
  padding: 18rpx 28rpx;
  margin: 30rpx 0;
  box-shadow: 0 6rpx 18rpx rgba(46, 125, 50, 0.10);
}
.r-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  padding: 14rpx 0;
  border-top: 2rpx solid #F1F8F2;
}
.r-row:first-child { border-top: none; }
.r-label { color: #4E6E50; font-weight: 600; }
.r-val { color: #2E7D32; font-weight: 800; }
.btn-plain {
  background: #fff;
  color: #43A047;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 18rpx 0;
  margin-top: 18rpx;
  border: 2rpx solid #A5D6A7;
}
.btn-plain::after { border: none; }
.r-cross {
  font-size: 26rpx;
  color: #6E8A72;
  margin-top: 24rpx;
  text-align: center;
}
