/* packages/toolsB/moneyExchange/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #FF9A3D 0%, #FF6A3D 100%);
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

/* 介绍页 */
.intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.intro-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.intro-subtitle {
  font-size: 30rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 40rpx;
}

.intro-desc {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.intro-desc text {
  font-size: 30rpx;
  color: rgba(255,255,255,0.9);
  line-height: 2;
}

.start-btn {
  width: 80%;
  height: 96rpx;
  background: #fff;
  color: #FF6A3D;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  line-height: 96rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
}

/* 历史记录 */
.history-section {
  width: 100%;
  margin-top: 60rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.history-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.12);
}

.history-item:last-child {
  border-bottom: none;
}

.history-score {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
}

.history-time {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 答题页 */
.quiz {
  padding-top: 20rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 4rpx;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.question-count {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 32rpx;
}

.question-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 56rpx;
  padding: 0 20rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
  transition: transform 0.15s ease, background 0.2s ease;
}

.option-btn:active {
  transform: scale(0.97);
}

.option-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.opt-correct {
  background: #2ECC71 !important;
}

.opt-correct .option-text {
  color: #fff !important;
}

.opt-wrong {
  background: #E74C3C !important;
}

.opt-wrong .option-text {
  color: #fff !important;
}

.feedback {
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
  margin-top: 36rpx;
}

.next-btn {
  width: 80%;
  height: 92rpx;
  background: #fff;
  color: #FF6A3D;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 46rpx;
  border: none;
  line-height: 92rpx;
  margin: 40rpx auto 0;
  display: block;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.18);
}

/* 结果页 */
.result {
  padding-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  letter-spacing: 8rpx;
}

.result-score {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.result-comment {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 60rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.restart-btn, .home-btn, .share-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  line-height: 88rpx;
}

.restart-btn {
  background: #fff;
  color: #FF6A3D;
}

.home-btn {
  background: rgba(255,255,255,0.25);
  color: #fff;
}

.share-btn {
  background: rgba(255,255,255,0.25);
  color: #fff;
}
