.tool-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.tool-header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.tool-header-fav {
  font-size: 44rpx;
  padding: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 20rpx;
  display: block;
}

/* ===== 介绍卡 ===== */
.intro-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.intro-emoji {
  font-size: 64rpx;
}

.intro-text {
  flex: 1;
  font-size: 27rpx;
  color: #666;
  line-height: 1.6;
}

/* ===== 难度选择 ===== */
.level-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.level-item {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.2s;
}

.level-item.level-active {
  background-color: #45B058;
}

.level-label {
  font-size: 29rpx;
  font-weight: 600;
  color: #333;
}

.level-desc {
  font-size: 23rpx;
  color: #999;
}

.level-active .level-label,
.level-active .level-desc {
  color: #fff;
}

/* ===== 通用选项 ===== */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  transition: all 0.2s;
}

.option-item.option-active {
  background-color: #45B058;
}

.option-text {
  font-size: 28rpx;
  color: #333;
}

.option-active .option-text {
  color: #fff;
  font-weight: 600;
}

/* ===== 状态栏 ===== */
.status-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  margin-bottom: 8rpx;
}

.status-item {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.status-label {
  font-size: 24rpx;
  color: #999;
}

.status-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #45B058;
  text-align: center;
}

.streak-value {
  color: #FF6B35;
}

.ok-value {
  color: #27AE60;
}

.bad-value {
  color: #E74C3C;
}

/* ===== 数列卡片 ===== */
.question-card {
  padding: 44rpx 20rpx 36rpx;
  margin-bottom: 24rpx;
}

.seq-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  row-gap: 20rpx;
}

.seq-card {
  min-width: 88rpx;
  height: 96rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  background-color: #F4F7F5;
  border: 3rpx solid #DFE8E2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.seq-card-sm {
  min-width: 72rpx;
  height: 84rpx;
  padding: 0 6rpx;
}

.seq-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
}

.seq-card-sm .seq-num {
  font-size: 34rpx;
}

/* 挖空位 */
.seq-card-blank {
  background-color: #FFF7E8;
  border: 3rpx dashed #F5A623;
}

.seq-card-blank .seq-num {
  color: #F5A623;
}

/* 填错的数闪红 */
.seq-card-wrongv {
  background-color: #FDECEA;
  border-color: #E74C3C;
  animation: shake 0.4s;
}

.seq-card-wrongv .seq-num {
  color: #E74C3C;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

/* 揭示后的答案格 */
.seq-card-answer {
  background-color: #E8F7EE;
  border: 3rpx solid #27AE60;
  animation: pop 0.35s;
}

.seq-card-answer .seq-num {
  color: #27AE60;
}

@keyframes pop {
  0% { transform: scale(0.6); }
  70% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

/* 双数列配色（揭示后） */
.seq-card-grpa {
  background-color: #E8F1FB;
  border-color: #4A90D9;
}

.seq-card-grpa .seq-num {
  color: #2E6DA8;
}

.seq-card-grpb {
  background-color: #FDF1E3;
  border-color: #E8963E;
}

.seq-card-grpb .seq-num {
  color: #C46A10;
}

/* 差值标注 */
.mark-slot {
  display: flex;
  align-items: center;
}

.seq-mark {
  font-size: 24rpx;
  font-weight: 700;
  color: #F5A623;
  background-color: #FFF7E8;
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  animation: fadein 0.5s;
}

@keyframes fadein {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 提示与反馈 ===== */
.hint-box {
  margin-top: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background-color: #FFF7E8;
}

.hint-text {
  font-size: 27rpx;
  color: #B47A16;
  line-height: 1.6;
}

.feedback {
  margin-top: 24rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.feedback-correct {
  background-color: rgba(39, 174, 96, 0.1);
  color: #27AE60;
}

.feedback-wrong {
  background-color: rgba(231, 76, 60, 0.1);
  color: #E74C3C;
}

.feedback-icon {
  font-size: 29rpx;
  line-height: 1.5;
}

/* ===== 选项 ===== */
.opt-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.opt {
  width: calc(50% - 10rpx);
  height: 110rpx;
  border-radius: 16rpx;
  background-color: #fff;
  border: 3rpx solid #DFE8E2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.15s;
}

.opt-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #2C3E50;
}

.opt-right {
  background-color: #E8F7EE;
  border-color: #27AE60;
}

.opt-right .opt-num {
  color: #27AE60;
}

.opt-wrong {
  background-color: #FDECEA;
  border-color: #E74C3C;
  animation: shake 0.4s;
}

.opt-wrong .opt-num {
  color: #E74C3C;
}

.opt-dim {
  opacity: 0.45;
}

/* ===== 填空 ===== */
.answer-area {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: center;
}

.answer-input {
  flex: 1;
  height: 88rpx;
  border: 2rpx solid #ECEFF1;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  background-color: #fff;
}

.answer-area .btn-primary {
  width: 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin: 0;
}

.next-area {
  margin-bottom: 24rpx;
}

.finish-area {
  text-align: center;
}

.btn-finish {
  background: none;
  border: none;
  color: #999;
  font-size: 28rpx;
  padding: 16rpx;
}

.btn-finish::after {
  border: none;
}

/* ===== 结果页 ===== */
.result-emoji {
  text-align: center;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.result-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 32rpx;
  display: block;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #2C3E50;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.result-detail {
  padding-top: 24rpx;
  border-top: 1rpx solid #ECEFF1;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  gap: 16rpx;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
}

.detail-bar-wrap {
  flex: 1;
  height: 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.detail-bar {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
  min-width: 80rpx;
  text-align: right;
}

/* 各类型表现 */
.tstat-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tstat-row:last-child {
  border-bottom: none;
}

.tstat-label {
  flex: 1;
  font-size: 28rpx;
  color: #2C3E50;
}

.tstat-ok {
  font-size: 28rpx;
  font-weight: 600;
  color: #27AE60;
  width: 100rpx;
  text-align: right;
}

.tstat-bad {
  font-size: 28rpx;
  font-weight: 600;
  color: #E74C3C;
  width: 100rpx;
  text-align: right;
}

/* 错题 */
.wrong-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.wrong-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.wrong-item:last-child {
  border-bottom: none;
}

.wrong-expr {
  font-size: 28rpx;
  color: #2C3E50;
  flex: 1;
}

.wrong-correct {
  font-size: 28rpx;
  font-weight: 600;
}

.btn-group {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #f0f0f0;
  color: #666;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}
